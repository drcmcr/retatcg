{
  "name": "retatcg",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "npm test -w @reta/torneo && npm test -w web --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:db": "vitest run --config vitest.config.mts"
  },
  "devDependencies": {
    "postgres": "^3.4.5",
    "vitest": "^5.1.1"
  }
}
